# Configs shell layer: shared by bash and zsh on every machine.
#
# Loaded from the block that `make -f shell/Makefile link` writes into
# ~/.bashrc and ~/.zshrc. That block sets CONFIGS_SHELL_DIR first.
#
# Order: shared settings -> gui.rc or server.rc -> zsh prompt -> local.rc

case $- in
  *i*) ;;
  *) return ;;
esac

# --- Paths ---------------------------------------------------------------

[ -d "$HOME/Work" ] && WORK="$HOME/Work" || WORK="$HOME"
export WORK
export CONFIGS_PATH="$WORK/Configs"
export PROJECTS_PATH="$WORK/Projects"
export BACKUPS_PATH="$WORK/BackUps"
CONFIGS_SHELL_DIR="${CONFIGS_SHELL_DIR:-$CONFIGS_PATH/shell}"

function _configs_path_prepend {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}
_configs_path_prepend "$HOME/.local/bin"
_configs_path_prepend "$HOME/.cargo/bin"
_configs_path_prepend "$HOME/.local/share/fnm"
export PATH

# --- Editor --------------------------------------------------------------

if command -v nvim >/dev/null 2>&1; then
  EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
  EDITOR=vim
else
  EDITOR=vi
fi
export EDITOR
export VISUAL="$EDITOR"

function choose_editor { command "$EDITOR" "$@"; }
alias v=choose_editor
alias vi=choose_editor

# --- Everyday helpers ----------------------------------------------------

alias Configs='cd "$CONFIGS_PATH"; ls -ls'
alias Projects='cd "$PROJECTS_PATH"; ls -ls'

# Frameworks such as oh-my-zsh predefine some of these names as aliases.
unalias la chx cdl 2>/dev/null
function la { command ls "$@" -la --color=auto; }
function chx { command chmod u+x "$@"; }
function cdl { cd "$@" && ls -la --color=auto; }

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
  alias lcat='/usr/bin/cat'
elif command -v batcat >/dev/null 2>&1; then
  alias cat='batcat --paging=never'
  alias lcat='/usr/bin/cat'
fi

# Send deletes to trash when the helper is available.
if command -v trash >/dev/null 2>&1; then
  alias rm='trash'
  alias trashbox='trash --help'
fi

alias rsss="remote_start_sudo_script.sh"
# SSH to the machines by name; addresses live in the private ~/.ssh/config.
alias pve='ssh pve'
alias dev='ssh dev'
alias end='ssh end'
alias eos='ssh eos'
alias prod='ssh prod'
alias cachy='ssh cachy'
alias pve-ts='ssh pve-ts'
alias dev-ts='ssh dev-ts'
alias end-ts='ssh end-ts'
alias eos-ts='ssh eos-ts'
alias prod-ts='ssh prod-ts'
alias cachy-ts='ssh cachy-ts'
alias win-ts='ssh win-ts'

# win: Windows shell kept in a tmux session on pve, so it survives connection drops.
unalias win 2>/dev/null
function win {
  if [ "$(hostname -s)" != pve ]; then
    ssh -t pve tmux new-session -A -s win ssh win
  elif [ -n "${TMUX:-}" ]; then
    tmux has-session -t win 2>/dev/null || tmux new-session -d -s win ssh win
    tmux switch-client -t win
  else
    tmux new-session -A -s win ssh win
  fi
}

# --- System update (by package family) -----------------------------------

if command -v pacman >/dev/null 2>&1; then
  alias upd='make -C "$CONFIGS_PATH/eos" update'
  alias updf='make -C "$CONFIGS_PATH/eos" updf'
elif command -v apt-get >/dev/null 2>&1; then
  alias upd='sudo apt-get update && sudo apt-get full-upgrade'
  alias updf='sudo apt-get update && sudo apt-get full-upgrade && sudo apt-get autoremove --purge'
fi

# --- tmux: t1..t5 attach to (or create) numbered sessions, tl lists them --

function _tmux_apply_status {
  tmux set-option -g mouse on >/dev/null
  tmux set-option -g status-left-length 40 >/dev/null
  tmux set-option -g status-left " #h:#S " >/dev/null
}

function _tmux_connect {
  local session="$1"
  _tmux_apply_status

  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

function _tmux_slot {
  local slot="$1"
  local host="${HOST:-${HOSTNAME:-$(hostname)}}"
  local legacy_host_session="${host%%.*}_${slot}"

  if tmux has-session -t "$slot" 2>/dev/null; then
    _tmux_connect "$slot"
    return
  fi

  if tmux has-session -t "$legacy_host_session" 2>/dev/null; then
    tmux rename-session -t "$legacy_host_session" "$slot" 2>/dev/null || true

    if tmux has-session -t "$slot" 2>/dev/null; then
      _tmux_connect "$slot"
    else
      _tmux_connect "$legacy_host_session"
    fi
    return
  fi

  tmux new-session -d -s "$slot"
  _tmux_connect "$slot"
}

for _t in 1 2 3 4 5; do
  alias "t$_t"="_tmux_slot $_t"
done
unset _t
alias tl="tmux list-sessions"

# --- AIX and AI agents ---------------------------------------------------

if [ -r "$WORK/AIX/env" ]; then
  . "$WORK/AIX/env"
fi

function ai {
  command make -s -C "$CONFIGS_PATH/ai" "$@"
}

# An interactive agent started from a plain terminal runs in its own tmux
# session (codexk, codexk-2, ...), so a closed window or a dropped ssh does
# not end it. Inside tmux, for one-shot commands (claude -p, codex exec,
# login, update, --version), or without tmux the agent runs directly.
# `command codex` always runs it directly. AIX starts agents by absolute
# path and never goes through these aliases.
function _agent_is_batch {
  local program="$1" arg
  shift

  case "$program:${1:-}" in
    codex:exec|codex:e|codex:review|codex:login|codex:logout|codex:mcp|\
    codex:mcp-server|codex:app-server|codex:completion|codex:sandbox|\
    codex:debug|codex:apply|codex:a|codex:cloud|codex:features|codex:help|\
    codex:update)
      return 0 ;;
    claude:mcp|claude:plugin|claude:plugins|claude:doctor|claude:update|\
    claude:upgrade|claude:install|claude:setup-token|claude:config|\
    claude:auth|claude:agents|claude:migrate-installer)
      return 0 ;;
    gemini:mcp|gemini:extensions)
      return 0 ;;
  esac

  for arg in "$@"; do
    case "$program:$arg" in
      *:-h|*:--help|*:--version|codex:-V|claude:-v|gemini:-v) return 0 ;;
      claude:-p|claude:--print|gemini:-p|gemini:--prompt) return 0 ;;
    esac
  done
  return 1
}

# Usage: [VAR=value ...] _agent SESSION PROGRAM [ARGS...]
function _agent {
  local name="$1" program="$2" bin session n=2
  shift 2

  if [ -n "${TMUX:-}" ] || [ ! -t 0 ] || [ ! -t 1 ] ||
     ! command -v tmux >/dev/null 2>&1 ||
     _agent_is_batch "$program" "$@"; then
    command "$program" "$@"
    return
  fi

  if [ -n "${ZSH_VERSION:-}" ]; then
    bin="$(whence -p "$program")"
  else
    bin="$(type -P "$program")"
  fi
  if [ -z "$bin" ]; then
    echo "$program: not installed" >&2
    return 127
  fi

  session="$name"
  while tmux has-session -t "=$session" 2>/dev/null; do
    session="$name-$n"
    n=$((n + 1))
  done

  # A running tmux server does not pass this shell's environment on.
  local -a envs
  envs=(-e "PATH=$PATH")
  if [ -n "${CODEX_HOME:-}" ]; then envs+=(-e "CODEX_HOME=$CODEX_HOME"); fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then envs+=(-e "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR"); fi
  if [ -n "${AIX_DEV_HOME:-}" ]; then envs+=(-e "AIX_DEV_HOME=$AIX_DEV_HOME"); fi

  tmux new-session -s "$session" -c "$PWD" "${envs[@]}" -- "$bin" "$@"
}

alias claude='_agent claude claude'
alias codex='_agent codex codex'
alias gemini='_agent gemini gemini'
alias ge='_agent gemini gemini'
alias claudem='CLAUDE_CONFIG_DIR=$HOME/.claude-m _agent claudem claude'
alias claudek='CLAUDE_CONFIG_DIR=$HOME/.claude-k _agent claudek claude'
alias claudes='CLAUDE_CONFIG_DIR=$HOME/.claude-s _agent claudes claude'
alias codexs='CODEX_HOME=$HOME/.codex-s _agent codexs codex'
alias codexm='CODEX_HOME=$HOME/.codex-m _agent codexm codex'
alias codexk='CODEX_HOME=$HOME/.codex-k _agent codexk codex'
# AIX dev variants: same accounts, but run freshly-built aix-mcp (AIX_DEV_HOME)
alias codex-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev _agent codex-dev codex'
alias codexs-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CODEX_HOME=$HOME/.codex-s _agent codexs-dev codex'
alias codexm-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CODEX_HOME=$HOME/.codex-m _agent codexm-dev codex'
alias codexk-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CODEX_HOME=$HOME/.codex-k _agent codexk-dev codex'
alias claudem-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CLAUDE_CONFIG_DIR=$HOME/.claude-m _agent claudem-dev claude'
alias claudek-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CLAUDE_CONFIG_DIR=$HOME/.claude-k _agent claudek-dev claude'
alias claudes-dev='AIX_DEV_HOME=$HOME/Work/Projects/aixdev CLAUDE_CONFIG_DIR=$HOME/.claude-s _agent claudes-dev claude'

# --- pass: pull before and push after every change -----------------------

export PASSWORD_STORE_DIR="$WORK/.password-store"

function _pw_pull {
  command pass git pull --rebase --autostash
}

function _pw_push {
  command pass git push || {
    echo "pass push failed; local commit is kept"
    return 1
  }
}

function pw {
  _pw_pull || return
  command pass "$@"
}

function pws {
  command pass git status --short --branch
}

function pwsync {
  _pw_pull || return
  _pw_push
}

function pwedit {
  _pw_pull || return
  command pass edit "$@" || return
  _pw_push
}

function pwadd {
  _pw_pull || return
  command pass insert "$@" || return
  _pw_push
}

function pwgen {
  _pw_pull || return
  command pass generate "$@" || return
  _pw_push
}

# --- fnm (Node version manager) ------------------------------------------

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell "${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}")"
fi

# --- Machine class: gui (has a graphical session) or server --------------

if [ -d /usr/share/xsessions ] || [ -d /usr/share/wayland-sessions ]; then
  CONFIGS_SHELL_CLASS=gui
else
  CONFIGS_SHELL_CLASS=server
fi
export CONFIGS_SHELL_CLASS

. "$CONFIGS_SHELL_DIR/$CONFIGS_SHELL_CLASS.rc"

# --- zsh only: quiet line editor and powerlevel10k prompt ----------------

if [ -n "${ZSH_VERSION:-}" ]; then
  # Keep BEL for codex/claude notifications over SSH, not for editing errors.
  unsetopt beep hist_beep list_beep

  POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(context os_icon dir vcs)
  POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status command_execution_time background_jobs direnv asdf virtualenv anaconda pyenv goenv nodenv nvm nodeenv rbenv rvm fvm luaenv jenv plenv phpenv scalaenv haskell_stack kubecontext terraform aws aws_eb_env azure gcloud google_app_cred toolbox ranger nnn xplr vim_shell midnight_commander nix_shell vi_mode todo timewarrior taskwarrior)
  POWERLEVEL9K_OS_ICON_BACKGROUND='#2B2E37'
  POWERLEVEL9K_OS_ICON_FOREGROUND='#3f7fbd'
  POWERLEVEL9K_LINUX_ENDEAVOUROS_ICON=$''
  POWERLEVEL9K_DIR_BACKGROUND='#3f7fbd'
  POWERLEVEL9K_DIR_FOREGROUND='#d8dee9'
  POWERLEVEL9K_CONTEXT_TEMPLATE='%n@%m'
  unset POWERLEVEL9K_CONTEXT_DEFAULT_CONTENT_EXPANSION
  unset POWERLEVEL9K_CONTEXT_DEFAULT_VISUAL_IDENTIFIER_EXPANSION

  for _p10k_theme in \
    /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
    /usr/share/powerlevel10k/powerlevel10k.zsh-theme \
    /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme \
    /usr/local/share/powerlevel10k/powerlevel10k.zsh-theme \
    "$HOME/.powerlevel10k/powerlevel10k.zsh-theme"; do
    if [ -r "$_p10k_theme" ]; then
      . "$_p10k_theme"
      break
    fi
  done
  unset _p10k_theme
  (( $+functions[p10k] )) && p10k reload
fi

# --- Machine-local additions, kept outside git ---------------------------

if [ -r "$HOME/.config/configs/local.rc" ]; then
  . "$HOME/.config/configs/local.rc"
fi
