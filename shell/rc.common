# Shared POSIX-safe shell environment.
# Intended for both bash and zsh.

if [ -d "$HOME/Work" ]; then
  WORK="$HOME/Work"
else
  WORK="$HOME"
fi

export WORK
export CONFIGS_PATH="$WORK/Configs"
export PROJECTS_PATH="$WORK/Projects"
export BACKUPS_PATH="$WORK/BackUps"
export PASSWORD_STORE_DIR="$WORK/.password-store"

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac

case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) PATH="$HOME/.cargo/bin:$PATH" ;;
esac

export PATH

if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
else
  export EDITOR=vi
fi

export VISUAL="${VISUAL:-$EDITOR}"

choose_editor() {
  if command -v nvim >/dev/null 2>&1; then
    command nvim "$@"
  elif command -v vim >/dev/null 2>&1; then
    command vim "$@"
  else
    command vi "$@"
  fi
}

ai() {
  command make -s -C "$CONFIGS_PATH/ai" "$@"
}
