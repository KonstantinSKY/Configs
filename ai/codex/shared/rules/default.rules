prefix_rule(pattern=["sqlite3", "/home/sky/Work/AIX/db/db.sqlite", "SELECT p.key AS project, 'rfc' AS kind, r.key, COALESCE(l.key,'') AS own_lifecycle, '' AS inherited_from, COALESCE(l.key,'') AS resolved_lifecycle, r.status FROM rfcs r JOIN projects p ON p.id=r.project_id LEFT JOIN lifecycles l ON l.id=r.lifecycle_id UNION ALL SELECT p.key, 'blueprint', b.key, COALESCE(lb.key,''), CASE WHEN lb.key IS NULL AND lr.key IS NOT NULL THEN r.key ELSE '' END, COALESCE(lb.key,lr.key,''), b.status FROM blueprints b JOIN projects p ON p.id=b.project_id JOIN rfcs r ON r.project_id=b.project_id AND r.key=b.rfc_key LEFT JOIN lifecycles lb ON lb.id=b.lifecycle_id LEFT JOIN lifecycles lr ON lr.id=r.lifecycle_id UNION ALL SELECT p.key, 'task', t.key, COALESCE(lt.key,''), CASE WHEN lt.key IS NULL AND lb.key IS NOT NULL THEN b.key WHEN lt.key IS NULL AND lb.key IS NULL AND lr.key IS NOT NULL THEN r.key ELSE '' END, COALESCE(lt.key,lb.key,lr.key,''), st.key FROM tasks t JOIN projects p ON p.id=t.project_id JOIN blueprints b ON b.project_id=t.project_id AND b.key=t.blueprint_key JOIN rfcs r ON r.project_id=t.project_id AND r.key=b.rfc_key LEFT JOIN lifecycles lt ON lt.id=t.lifecycle_id LEFT JOIN lifecycles lb ON lb.id=b.lifecycle_id LEFT JOIN lifecycles lr ON lr.id=r.lifecycle_id LEFT JOIN lifecycle_stages cls ON cls.id=t.current_lifecycle_stage_id LEFT JOIN stages st ON st.id=cls.stage_id ORDER BY project, kind, key;"], decision="allow")
